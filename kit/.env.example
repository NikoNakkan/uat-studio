# Copy to .env (never committed) and fill in.
# Agents never read .env; only tests/seed.spec.ts and playwright.config.ts do.

# The app under test. Must also be listed in config/guardrails.yaml (allowed_origins).
START_PAGE=http://localhost:4173

# Test accounts. The Excel's "Login as" column names one of them in plain words,
# e.g. "Employee test account" -> EMPLOYEE_TEST_ACCOUNT_USER / _PASSWORD.
# tests/login.ts logs them in (written once per app with /setup-login); the session is kept in
# runs/<run-id>/auth/ and reused by every test of that account.
EMPLOYEE_TEST_ACCOUNT_USER=
EMPLOYEE_TEST_ACCOUNT_PASSWORD=
MANAGER_TEST_ACCOUNT_USER=
MANAGER_TEST_ACCOUNT_PASSWORD=

# Optional, per account. A login session saved by another tool, used as it is instead of tests/login.ts
# (Microsoft Entra ID accounts with MFA or certificate sign-in, see login-patterns.md pattern 15), e.g.
# EMPLOYEE_TEST_ACCOUNT_STORAGE_STATE=../power-platform-playwright-samples/packages/e2e-tests/.playwright-ms-auth/state-employee@contoso.com.json

# Optional. A saved login session older than this is logged in again (default 30 minutes).
# UAT_SESSION_MAX_AGE_MIN=30
# Optional. Slow UAT environment? Raise the time a test / a single check may take (milliseconds).
# UAT_TEST_TIMEOUT_MS=60000
# UAT_EXPECT_TIMEOUT_MS=10000
